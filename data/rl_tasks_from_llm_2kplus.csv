 **Condition 1 (Django Model with Generic Foreign Key and Ordering):**

```python
from django.db import models
from django.contrib.contenttypes.fields import GenericForeignKey
from django.contrib.contenttypes.models import ContentType

class OrderedItem(models.Model):
    content_type = models.ForeignKey(ContentType, on_delete=models.CASCADE)
    object_id = models.PositiveIntegerField()
    content_object = GenericForeignKey('content_type', 'object_id')
    phrase = models.CharField(max_length=255)
    order = models.IntegerField(default=0)

    class Meta:
        ordering = ('-order',)
```

**Example:**

```python
Input: content_type = ContentType.objects.get_for_model(MyModel)
    obj = MyModel.objects.first()
    OrderedItem(content_type=content_type, object_id=obj.id, phrase='Hello World').save()
    OrderedItem(content_type=content_type, object_id=obj.id, phrase='Goodbye World').save()
    OrderedItem(content_type=content_type, object_id=obj.id, phrase='Hello Again', order=1).save(); Output: [OrderedItem(phrase='Hello Again'), OrderedItem(phrase='Goodbye World'), OrderedItem(phrase='Hello World')]
```

**Tests:**

```python
from django.test import TestCase
from myapp.models import OrderedItem

class TestOrderedItem(TestCase):
    def test_ordering(self):
        content_type = ContentType.objects.get_for_model(MyModel)
        obj = MyModel.objects.first()
        OrderedItem(content_type=content_type, object_id=obj.id, phrase='Hello World').save()
        OrderedItem(content_type=content_type, object_id=obj.id, phrase='Goodbye World').save()
        OrderedItem(content_type=content_type, object_id=obj.id, phrase='Hello Again', order=1).save()
        items = OrderedItem.objects.filter(content_object=obj)
        self.assertEqual(list(items), [OrderedItem(phrase='Hello Again'), OrderedItem(phrase='Goodbye World'), OrderedItem(phrase='Hello World')])
```

