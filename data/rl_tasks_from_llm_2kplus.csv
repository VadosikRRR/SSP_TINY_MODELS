class AuctionItem:
    def __init__(self, name, starting_price):
        self.name = name
        self.starting_price = starting_price
        self.current_bid = self.starting_price
        self.bidder = None

    def place_bid(self, bidder, bid):
        if bid < self.current_bid:
            raise ValueError(""Bid is lower than the current highest bid"")
        self.current_bid = bid
        self.bidder = bidder

    def display_bidding_history(self):
        if self.bidder is None:
            print(f""Bidding history for {self.name}: - {self.starting_price} by Starting Bidder"")
        else:
            print(f""Bidding history for {self.name}: - {self.starting_price} by Starting Bidder"")
            print(f""- {self.current_bid} by {self.bidder}"")

class AuctionSystem:
    def __init__(self):
        self.items = {}

    def add_item(self, name, starting_price):
        self.items[name] = AuctionItem(name, starting_price)

    def place_bid(self, item_name, bidder, bid):
        if item_name not in self.items:
            raise KeyError(f""Item {item_name} not found"")
        self.items[item_name].place_bid(bidder, bid)

    def display_highest_bids(self):
        for item_name, item in self.items.items():
            print(f""{item_name} - Current highest bid: ${item.current_bid} by {item.bidder}"")

    def display_bidding_history(self, item_name):
        if item_name not in self.items:
            raise KeyError(f""Item {item_name} not found"")
        self.items[item_name].display_bidding_history()
# Create an auction system
auction_system = AuctionSystem()

# Add items to the auction
auction_system.add_item(""Painting"", 100)
auction_system.add_item(""Antique Vase"", 200)

# Place bids on items
auction_system.place_bid(""Painting"", ""John Doe"", 150)
auction_system.place_bid(""Antique Vase"", ""Jane Smith"", 250)
auction_system.place_bid(""Painting"", ""Michael Johnson"", 200)

# Display current highest bids
auction_system.display_highest_bids()
# Output:
# Painting - Current highest bid: $200 by Michael Johnson
# Antique Vase - Current highest bid: $250 by Jane Smith

# Display bidding history for an item
auction_system.display_bidding_history(""Painting"")
# Output:
# Bidding history for Painting:
# - $100 by Starting Bidder
# - $150 by John Doe
# - $200 by Michael Johnson
def config_deepfool(targeted, adv_ys, yname, nb_candidate, overshoot, max_iter):
