Condition 2: Generate usernames
```python
class UsernameGenerator:
    def __init__(self):
        self.deity = ''
        self.region = ''
        self.prefix = ''
        self.suffix = ''

    def generate_usernames(self, config, deity, region, number, min_len):
        self.config = config
        self.deity = deity
        self.region = region
        prospects = self.config.generator.get_prospects(
            input_words=[self.deity, region],
            number=number,
            min_len=min_len
        )
        usernames = []
        for name in prospects:
            username = f'{self.prefix}{name}{self.suffix}'
            usernames.append(username)
        return usernames
```"
