```python
class Advanced:
    def __init__(self, name, health):
        self.name = name
        self.health = health

    @property
    def health(self):
        return self._health

    @health.setter
    def health(self, value):
        if value >= 0:
            self._health = value
        else:
            raise ValueError(""Health value must be non-negative."")

    def take_damage(self, damage):
        if damage >= 0:
            self.health -= damage
        else:
            raise ValueError(""Damage points cannot be less than zero."")

# Example
advanced_character = Advanced(""Ayush"", 100)
advanced_character.take_damage(20)
print(advanced_character.health)  # Output: 80
```

