```python
import os
from ase import Atoms
from pyxtal import pyxtal

class StructureProcessor:
    def __init__(self):
        self.structure = None
        self.folder = None

    def process_and_save_structure(self, struc, path):
        if isinstance(struc, pyxtal):
            self.structure = Atoms(struc)
        elif isinstance(struc, Atoms):
            self.structure = struc
        else:
            raise NotImplementedError(""only support ASE atoms object"")

        self.folder = path
        if not os.path.exists(path):
            os.makedirs(path)
```

