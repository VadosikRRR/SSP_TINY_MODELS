Task: Implement a Python class `WebAuth` for a simple user authentication system.

The `WebAuth` class should have the following methods:"
handle_redirects(follow_redirects)`: Set the behavior for handling redirects after login.,"Input: WebAuth().register('user1', 'password1'); Output: None
Input: WebAuth().login('user1', 'password1'); Output: True
Input: WebAuth().is_authenticated(); Output: False
Input: WebAuth().handle_redirects(False); Output: None
```","import unittest

class TestWebAuth(unittest.TestCase):
    def setUp(self):
        self.auth = WebAuth()

    def test_register(self):
        self.auth.register('user1', 'password1')
        self.assertTrue(self.auth.users.get('user1'))

    def test_login(self):
        self.auth.register('user1', 'password1')
        self.assertTrue(self.auth.login('user1', 'password1'))
        self.assertTrue(self.auth.is_authenticated())

    def test_logout(self):
        self.auth.register('user1', 'password1')
        self.auth.login('user1', 'password1')
        self.assertTrue(self.auth.is_authenticated())
        self.auth.logout()
        self.assertFalse(self.auth.is_authenticated())

    def test_handle_redirects(self):
        self.auth.register('user1', 'password1')
        self.auth.login('user1', 'password1')
        self.assertTrue(self.auth.is_authenticated())
        self.auth.handle_redirects(False)
        self.assertFalse(self.auth.redirects_enabled)

if __name__ == '__main__':
    unittest.main()"
