# /temp_dir/G2P/file1.txt
# /temp_dir/G2P/file2.txt
# /temp_dir/models/G2P/model1
# /temp_dir/models/G2P/model2

# Case 2: Simulate clean operation
file_cleanup(file_paths, False)
# Output:
# Files and directories to be deleted:
