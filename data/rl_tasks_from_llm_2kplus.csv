Process Input File,"Input: python process_input_file.py input.txt; Output: The sorted, unique list of integers is written to output.txt
```","import unittest

class TestProcessInputFile(unittest.TestCase):
    def test_process_input_file(self):
        with open('test_input.txt', 'w') as test_input_file:
            test_input_file.write('1\n2\n1\n3\n2\n1')
        process_input_file('test_input.txt')
        with open('output.txt', 'r') as output_file:
            self.assertEqual(sorted(output_file.read().splitlines()), ['1', '2', '3'])"
