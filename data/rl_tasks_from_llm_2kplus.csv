def plot_string_frequency(strings, suffix=None):
    if suffix:
        suffix_strings = [s for s in strings if s.endswith(suffix)]
    else:
        suffix_strings = strings

    frequency_dict = {}
    for string in suffix_strings:
        if string in frequency_dict:
            frequency_dict[string] += 1
        else:
            frequency_dict[string] = 1

    # Generate the plot using a suitable plotting library (e.g., matplotlib)
    # This implementation does not include the code for generating the plot
    for string, frequency in frequency_dict.items():
        print(f""{string}: {frequency}"")
