```python
import cv2

def loadVideo(Video_FILE, maskFile):
    # Load the mask image
    mask = cv2.imread(maskFile, 0)

    # Initialize video writer for the new video
    fourcc = cv2.VideoWriter_fourcc(*'MPV4')
    video_out = cv2.VideoWriter('new_video.mp4', fourcc, 30, (480, 848))

    # Iterate through each frame of the input video
    for frame in get_frames(Video_FILE):
        if frame is None:
            break

        # Apply inpainting to remove the mask from the frame
        dst = cv2.inpaint(frame, mask, 3, cv2.INPAINT_TELEA)

        # Write the processed frame to the new video file
        video_out.write(dst)

    # Release the video writer
    video_out.release()
```"
