Write the migration file that adds the stock_quantity field to the Product model,"Input: \n    from django.db import migrations\n    \n    class Migration(migrations.Migration):\n        dependencies = [('myapp', '0001_initial'),]\n        \n        operations = [migrations.AddField(model_name='product', name='stock_quantity', field=models.IntegerField(default=0))]\n        \n        class Migration(migrations.Operation):\n            def apply_upwards(self, apps, schema_editor):\n                Product = apps.get_model('myapp', 'Product')\n                db_alias = schema_editor.connection.alias\n                Product._meta.get_field('stock_quantity').db_column = 'stock_quantity_%s'\n                schema_editor.create_model(Product)\n            \n            def reverse_code(self, model_class=Product):\n                db_alias = self.connection.alias\n                model_class._meta.get_field('stock_quantity').db_column = 'stock_quantity'\n                schema_editor.delete_model(model_class)\n        \n    \n    # Run the migration
    python manage.py migrate myapp 0002\n; Output: The migration is applied, adding the 'stock_quantity' field to the Product model.""]}
