calculate_rmse([], [])  # Output: 0.0
calculate_rmse([1, 2, 3], [4, 5])  # Output: 1.87","import math

def calculate_rmse(predicted_values, actual_values):
    if len(predicted_values) != len(actual_values):
        raise ValueError(""Both lists must have the same length."")

    if not predicted_values and not actual_values:
        return 0.0

    mse = sum((predicted_i - actual_i) ** 2 for predicted_i, actual_i in zip(predicted_values, actual_values)) / len(predicted_values)
    return math.sqrt(mse)

# Test cases
print(calculate_rmse([3, 4, 5, 6], [2, 4, 4, 7]))  # Output: 1.29
print(calculate_rmse([], []))  # Output: 0.0
print(calculate_rmse([1, 2, 3], [4, 5]))  # Output: 1.87"
