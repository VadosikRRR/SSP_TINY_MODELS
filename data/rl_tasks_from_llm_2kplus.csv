    (r'^$', views.home, 'home'),
    (r'^about/$', views.about, 'about'),
    (r'^contact/$', views.contact, 'contact'),
]

parse_urlpatterns(urlpatterns)
# Output: {'home': ['/'], 'about': ['/about/'], 'contact': ['/contact/']}","def test_parse_urlpatterns():
    urlpatterns = [
        (r'^$', views.home, 'home'),
        (r'^about/$', views.about, 'about'),
        (r'^contact/$', views.contact, 'contact'),
    ]
    result = parse_urlpatterns(urlpatterns)
    assert result == {'home': ['/'], 'about': ['/about/'], 'contact': ['/contact/']}

    urlpatterns = [
        (r'^$', views.home, 'home'),
        (r'^about/', views.about, 'about'),
        (r'^contact/', views.contact, 'contact'),
    ]
    result = parse_urlpatterns(urlpatterns)
    assert result == {'home': ['/'], 'about': ['/about/'], 'contact': ['/contact/']}

    urlpatterns = []
    result = parse_urlpatterns(urlpatterns)
    assert result == {}

    urlpatterns = [(r'^$', views.home, 'home')]
    result = parse_urlpatterns(urlpatterns)
    assert result == {'home': ['/']}"
