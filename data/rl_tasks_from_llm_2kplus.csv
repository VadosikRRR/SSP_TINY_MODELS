```python
class General:
    def __init__(self, deployed=False, requisition={}):
        self.deployed = deployed
        self.requisition = requisition
        self.cost = sum(requisition.values())

    def can_deploy(self, requisition):
        if self.deployed:
            return False
        total_requisition = self.requisition.copy()
        total_requisition.update(requisition)
        if total_requisition.get(self.side, 0) >= self.cost:
            return True
        return False
```

