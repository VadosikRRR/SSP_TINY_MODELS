from your_task_manager_module import TaskManager, Task

class TestTaskManager(unittest.TestCase):
    def setUp(self):
        self.task_manager = TaskManager()

    def test_add_task(self):
        self.task_manager.add_task(Task(message_id=1, message=""Task 1""))
        self.assertEqual(self.task_manager.get_all_tasks(), [Task(message_id=1, message=""Task 1"")])

    def test_find_task(self):
        self.task_manager.add_task(Task(message_id=1, message=""Task 1""))
        self.task_manager.add_task(Task(message_id=2, message=""Task 2""))
        self.assertEqual(self.task_manager.find_task(1), Task(message_id=1, message=""Task 1""))
        self.assertIsNone(self.task_manager.find_task(3))

    def test_get_all_tasks(self):
        self.task_manager.add_task(Task(message_id=1, message=""Task 1""))
        self.task_manager.add_task(Task(message_id=2, message=""Task 2""))
        self.assertEqual(self.task_manager.get_all_tasks(), [Task(message_id=1, message=""Task 1""), Task(message_id=2, message=""Task 2"")])

    def test_remove_task(self):
        self.task_manager.add_task(Task(message_id=1, message=""Task 1""))
        self.task_manager.add_task(Task(message_id=2, message=""Task 2""))
        self.task_manager.remove_task(Task(message_id=1))
        self.assertEqual(self.task_manager.get_all_tasks(), [Task(message_id=2, message=""Task 2"")])

if __name__ == ""__main__"":
