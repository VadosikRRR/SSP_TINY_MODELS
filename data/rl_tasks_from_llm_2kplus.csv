# /temp_dir/G2P/file2.txt
# /temp_dir/models/G2P/model1
# /temp_dir/models/G2P/model2
from unittest.mock import patch
import os

class TestFileCleanup:
    def setup(self):
        self.file_paths = [
            'test_file1.txt',
            'test_file2.txt',
            'test_dir/test_file3.txt',
            'test_dir/test_file4.txt'
        ]

    def test_file_cleanup(self):
        with patch('os.remove', new=MagicMock(side_effect=Exception)) as mock_remove:
            file_cleanup(self.file_paths, True)
            mock_remove.assert_has_calls(map(mock.call, self.file_paths))

    def test_file_simulation(self):
        with patch('os.remove', new=MagicMock(return_value=None)) as mock_remove:
            file_cleanup(self.file_paths, False)
            mock_remove.assert_has_calls(map(mock.call, self.file_paths))

        for file_path in self.file_paths:
            assert not os.path.exists(file_path)
