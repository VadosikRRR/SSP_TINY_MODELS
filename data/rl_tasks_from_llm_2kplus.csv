Image Augmentation,"import PIL.Image as Image
import numpy as np

aug = AugStyle()
image = np.array(Image.open('example.png'))

augmented_image = aug.rotate(image, 45)
augmented_image = aug.flip(augmented_image, horizontal=True)
augmented_image = aug.scale(augmented_image, 0.5)
augmented_image = aug.color_manipulation(augmented_image, 1.5, 2.0)","import PIL.Image as Image
import numpy as np
import unittest

class TestAugStyle(unittest.TestCase):
    def test_rotate(self):
        aug = AugStyle()
        image = np.array(Image.open('example.png'))
        rotated_image = aug.rotate(image, 45)
        self.assertNotEqual(image, rotated_image)

    def test_flip(self):
        aug = AugStyle()
        image = np.array(Image.open('example.png'))
        flipped_image = aug.flip(image, horizontal=True)
        self.assertNotEqual(image, flipped_image)

    def test_scale(self):
        aug = AugStyle()
        image = np.array(Image.open('example.png'))
        scaled_image = aug.scale(image, 0.5)
        self.assertNotEqual(image, scaled_image)

    def test_color_manipulation(self):
        aug = AugStyle()
        image = np.array(Image.open('example.png'))
        manipulated_image = aug.color_manipulation(image, 1.5, 2.0)
        self.assertNotEqual(image, manipulated_image)

if __name__ == '__main__':
    unittest.main()"
