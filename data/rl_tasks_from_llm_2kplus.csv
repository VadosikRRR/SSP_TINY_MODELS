Input: rules = [""entity_rule1"", ""entity_rule2""]; Output: {""section_rules"": [], ""entity_rules"": [""rule1"", ""rule2""]}
Input: rules = [""section_[rule1]""]; Output: {""section_rules"": [""rule1""], ""entity_rules"": []}
```","import unittest

class TestProcessRules(unittest.TestCase):
    def test_process_rules(self):
        self.assertEqual(process_rules([""section_[rule1, rule2]"", ""entity_rule1"", ""section_[rule3]""]), {""section_rules"": [""rule1, rule2"", ""rule3""], ""entity_rules"": [""rule1""]})
        self.assertEqual(process_rules([""entity_rule1"", ""entity_rule2""]), {""section_rules"": [], ""entity_rules"": [""rule1"", ""rule2""]})
        self.assertEqual(process_rules([""section_[rule1]""]), {""section_rules"": [""rule1""], ""entity_rules"": []})

if __name__ == ""__main__"":
    unittest.main()"
