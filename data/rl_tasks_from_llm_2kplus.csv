```python
def reverseComplement(dna):
    complement = {'A': 'T', 'C': 'G', 'G': 'C', 'T': 'A'}
    reversed_dna = dna[::-1]
    complemented_dna = ''.join([complement[base] for base in reversed_dna])
    return complemented_dna
