class TestCombinationSum:
    def setup(self):
        self.candidates = [2, 3, 6, 7]

    def test_combination_sum(self):
        solution_set = [ [7], [2, 2, 3] ]
        self.assertEqual(combination_sum(self.candidates, 7), solution_set)

    def test_empty_candidates(self):
        self.assertEqual(combination_sum([], 7), [])

