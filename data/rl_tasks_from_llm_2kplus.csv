Condition 4: Data Preprocessing Function
```python
def preprocess_data(features, labels):
    batches = []
    batch_features, batch_labels = [], []

    for i in range(0, len(features), 4000):
        if i + 4000 < len(features):
            batch_features.append(features[i:i + 4000])
            batch_labels.append(labels[i:i + 4000])
        else:
            batches.append((batch_features, batch_labels))
            batch_features = [features[i:]]
            batch_labels = [labels[i:]]

    if batch_features:
        batches.append((batch_features, batch_labels))

    return batches
```
