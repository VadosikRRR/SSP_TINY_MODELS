The class should have a method `write_file` that takes a file path and writes the configuration to the file in the INI format.,"config = ConfigParser()
config.read_file(""config.ini"")
print(config.get(""Section1"", ""key1""))  # Output: value1
config.set(""Section1"", ""key1"", ""new_value1"")
config.write_file(""config.ini"")","import unittest
from io import StringIO

class TestConfigParser(unittest.TestCase):
    def test_read_file(self):
        config = ConfigParser()
        config_data = """"""
[Section1]
key1 = value1
key2 = value2

[Section2]
key3 = value3
""""""
        config.read_file(StringIO(config_data))
        self.assertEqual(config.get(""Section1"", ""key1""), ""value1"")
        self.assertEqual(config.get(""Section2"", ""key3""), ""value3"")

    def test_get_nonexistent_key(self):
        config = ConfigParser()
        config.read_file(StringIO(""""))
        with self.assertRaises(KeyError):
            config.get(""Section1"", ""nonexistent_key"")

    def test_set_and_write(self):
        config = ConfigParser()
        config.set(""Section1"", ""key1"", ""new_value1"")
        config.write_file(""temp.ini"")
        config_data = """"""
[Section1]
key1 = new_value1
""""""
        with open(""temp.ini"", ""r"") as f:
            self.assertEqual(f.read(), config_data)

if __name__ == ""__main__"":
    unittest.main()"
