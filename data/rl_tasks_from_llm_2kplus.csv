from unittest.mock import MagicMock

class TestProcessOptions:
    def setup(self):
        self.current_options = {
            'formatted_option1': 'prefix1formatted_option1;',
            'formatted_option2': 'prefix2formatted_option2;'
        }

    def test_valid_options(self):
        self.assertTrue(process_options(self.current_options, ('arg1', 'arg2'), 'prefix', ['formatted_option1', 'formatted_option2']))

    def test_invalid_format(self):
        self.assertFalse(process_options(self.current_options, ('arg1', 'arg2'), 'prefix', ['formatted_option1arg1', 'formatted_option2']))

    def test_conflicting_options(self):
        self.assertFalse(process_options(self.current_options, ('arg1', 'arg2'), 'prefix', ['formatted_option1', 'prefix1formatted_option3']))
