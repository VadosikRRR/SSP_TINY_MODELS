```python
import requests

class KubernetesClient:
    def __init__(self, namespace=None):
        self.namespace = namespace

    def select_pod(self, criteria):
        # Implementation selects a pod based on the given criteria
        pod_ip = ""192.168.0.1""  # Example pod IP
        pod_name = ""example-pod""  # Example pod name
        print(f""selected pod: ip = {pod_ip}, name = {pod_name}"")
        return pod_ip, pod_name

    def send_api_call(self, pod_ip, data, api_resource):
        if self.namespace:
            out = requests.put(f""http://{pod_ip}:8080/{self.namespace}/{api_resource}"", json=data)
        else:
            out = requests.put(f""http://{pod_ip}:8080/{api_resource}"", json=data)
        return out

# Create a KubernetesClient instance
client = KubernetesClient()

# Select a pod
pod_ip, pod_name = client.select_pod({""label"": ""app=my-app""})

# Send the API call to the selected pod
response = client.send_api_call(pod_ip, {""key"": ""value""}, ""api-resource"")

# Print the response
print(response.json())
```

