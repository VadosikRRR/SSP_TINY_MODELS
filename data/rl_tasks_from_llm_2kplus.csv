# Task: Iterate through each class folder and perform a specific operation on the files within each folder.

def process_class_folders(classes: List[str]) -> List[str]:
    results = []
    for class_folder in classes:
        for file in os.listdir(class_folder):
            file_path = os.path.join(class_folder, file)
            result = perform_operation(file_path)
            results.append(result)
    return results

