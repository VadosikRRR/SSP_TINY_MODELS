class TestDirectoryScanner(unittest.TestCase):
    def setUp(self):
        self.scanner = DirectoryScanner()

    def test_scan_dir_tree_regular(self):
        dir_tree = ['folder1', 'file1.txt', 'folder2', 'folder3', 'file2.txt']
        result = self.scanner.scan_dir_tree(dir_tree, 'root', '/', None, False)
        expected = {
            'root': {
                'files': ['file1.txt', 'file2.txt'],
                'directories': ['folder1', 'folder2', 'folder3']
            }
        }
        self.assertDictEqual(result, expected)

    def test_scan_dir_tree_demo(self):
        dir_tree = ['folder1', 'file1.txt', 'folder2', 'folder3', 'file2.txt']
        result = self.scanner.scan_dir_tree(dir_tree, 'root', '/', None, True)
        expected = {
            'root': {
                'files': ['file1.txt'],
                'directories': ['folder1']
            }
        }
        self.assertDictEqual(result, expected)

