```","import unittest

class TestArrayReorder(unittest.TestCase):
    def test_example_1(self):
        self.assertEqual(max_query_sum([5, 3, 2], [[0, 2], [2, 2]]), 9)

    def test_example_2(self):
        self.assertEqual(max_query_sum([1, 2, 3, 4, 5], [[0, 4], [2, 4]]), 13)

    def test_case_1(self):
        self.assertEqual(max_query_sum([1, 2, 3, 4, 5, 6], [[0, 3], [2, 4]]), 15)

    def test_case_2(self):
        self.assertEqual(max_query_sum([1, 2, 3, 4, 5, 6, 7], [[0, 3], [3, 6]]), 21)

    def test_case_3(self):
        self.assertEqual(max_query_sum([1, 2, 3, 4, 5, 6, 7, 8], [[0, 4], [2, 6]]), 20)

if __name__ == ""__main__"":
    unittest.main()"
