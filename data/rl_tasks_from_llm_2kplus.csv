Django Model for News Item Tracking System,"Input: NewsItem.objects.create(type='new_account', payload={'username': 'john_doe'}, paprika_account=paprika_account_obj); Output: A new NewsItem object is created with the specified type, payload, and associated PaprikaAccount.
Input: news_item_obj.payload; Output: {'username': 'john_doe'}
```","from django.test import TestCase
from django.contrib.auth.models import User
from .models import PaprikaAccount, NewsItem

class NewsItemTest(TestCase):
    def setUp(self):
        self.paprika_account = PaprikaAccount.objects.create()
        self.user = User.objects.create_user(username='john_doe')
        self.paprika_account.user = self.user
        self.paprika_account.save()

    def test_create_news_item(self):
        news_item = NewsItem.objects.create(type='new_account', payload={'username': 'john_doe'}, paprika_account=self.paprika_account)
        self.assertEqual(news_item.paprika_account, self.paprika_account)
        self.assertEqual(news_item.payload, {'username': 'john_doe'})

    def test_get_news_item_payload(self):
        news_item = NewsItem.objects.create(type='new_account', payload={'username': 'john_doe'}, paprika_account=self.paprika_account)
        self.assertEqual(news_item.payload, {'username': 'john_doe'})"
