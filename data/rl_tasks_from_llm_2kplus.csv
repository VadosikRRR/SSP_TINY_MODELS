Condition 2: Poker Hand Evaluation Function
```python
def Royal_Flush(hand):
    return all(sorted(hand) == [10, 'J', 'Q', 'K', 'A'] and all(hand[i][1] == hand[0][1] for i in range(1, len(hand))))

def Straight_Flush(hand):
    return all(sorted(hand) == sorted(hand[0])) and all(hand[i][0] == hand[0][0] for i in range(1, len(hand)))

def Four_of_a_Kind(hand):
    return len(set([card[0] for card in hand])) == 1 and len(list(filter(lambda x: len(list(filter(lambda y: y[0] == x[0], hand)) == 4, enumerate(hand))))[0]) == 4

def Full_House(hand):
    return len(set([card[0] for card in hand])) == 2 and len(list(filter(lambda x: len(list(filter(lambda y: y[0] == x[0], hand)) == 3, enumerate(hand))))[0]) == 3

def Crupier(hand):
    ranks = [Royal_Flush, Straight_Flush, Four_of_a_Kind, Full_House, Flush, Straight, Three_of_a_Kind, Two_Pair, One_Pair, High_Card]
    for rank in ranks:
        if rank(hand):
            return rank.__name__, hand
    return ""High Card"", hand
```
