Binary Search Tree (BST),"bst = BinarySearchTree()
bst.root = bst.insert(bst.root, 50)
bst.root = bst.insert(bst.root, 30)
bst.root = bst.insert(bst.root, 20)
bst.root = bst.insert(bst.root, 40)
bst.root = bst.insert(bst.root, 70)
bst.root = bst.insert(bst.root, 60)
bst.root = bst.insert(bst.root, 80)

print(bst.root.data)  # Output: 50","from unittest.mock import Mock

class TestBinarySearchTree:
    def test_insert(self):
        bst = BinarySearchTree()
        bst.root = bst.insert(bst.root, 50)
        bst.root = bst.insert(bst.root, 30)
        bst.root = bst.insert(bst.root, 20)
        bst.root = bst.insert(bst.root, 40)
        bst.root = bst.insert(bst.root, 70)
        bst.root = bst.insert(bst.root, 60)
        bst.root = bst.insert(bst.root, 80)

        assert bst.root.data == 50
        assert bst.root.left.data == 30
        assert bst.root.right.data == 70
        assert bst.root.left.left.data == 20
        assert bst.root.left.right.data == 40
        assert bst.root.right.left.data == 60
        assert bst.root.right.right.data == 80

    def test_insert_duplicates(self):
        bst = BinarySearchTree()
        bst.root = bst.insert(bst.root, 50)
        bst.root = bst.insert(bst.root, 50)
        bst.root = bst.insert(bst.root, 30)
        bst.root = bst.insert(bst.root, 20)
        bst.root = bst.insert(bst.root, 40)
        bst.root = bst.insert(bst.root, 70)
        bst.root = bst.insert(bst.root, 60)
        bst.root = bst.insert(bst.root, 80)

        assert bst.root.data == 50
        assert bst.root.left.data == 30
        assert bst.root.right.data == 70
        assert bst.root.left.left.data == 20
        assert bst.root.left.right.data == 40
        assert bst.root.right.left.data == 60
        assert bst.root.right.right.data == 80

    def test_insert_empty(self):
        bst = BinarySearchTree()
        bst.root = bst.insert(bst.root, 50)

        assert bst.root.data == 50
        assert bst.root.left is None
        assert bst.root.right is None"
