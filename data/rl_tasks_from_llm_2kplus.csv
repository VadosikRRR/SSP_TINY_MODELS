Distance Class,"import unittest

class TestDistance(unittest.TestCase):
    def test_from_metres(self):
        distance = Distance.from_metres(1)
        self.assertAlmostEqual(distance.metres, 1.0)
        self.assertAlmostEqual(distance.feet, 3.28084)

    def test_from_feet(self):
