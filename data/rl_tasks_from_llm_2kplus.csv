    ""add"": lambda x, y: x + y,
    ""subtract"": lambda x, y: x - y
}

result = execute_queryable(operations, ""add"", a=3, b=2)
print(result)  # Output: 5

result = execute_queryable(operations, ""subtract"", a=5, b=3)
print(result)  # Output: 2

result = execute_queryable(operations, ""add"", a=3, b=2, query=""[0]"")
print(result)  # Output: 5","# Test cases
tests = [
    {""operation"": ""add"", ""args"": {""a"": 3, ""b"": 2}, ""expected"": 5},
    {""operation"": ""subtract"", ""args"": {""a"": 5, ""b"": 3}, ""expected"": 2},
    {""operation"": ""add"", ""args"": {""a"": 3, ""b"": 2}, ""query"": ""[0]"", ""expected"": 5},
    {""operation"": ""nonexistent_operation"", ""args"": {""a"": 3, ""b"": 2}, ""expected"": None}
]

for test in tests:
    result = execute_queryable(operations, test[""operation""], **test[""args""])
    if test[""query""]:
        result = result[0]
    assert result == test[""expected""]"
