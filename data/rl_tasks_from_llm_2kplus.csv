Condition 4: Implement an object detection algorithm using selective search and visualize the proposed regions for object detection.

```python
import cv2
import numpy as np

def object_detection_visualization(image_path):
    # Import the necessary libraries and initialize the first step of the selective search algorithm
    import selective_search as ss

    # Load the input image
    image = cv2.imread(image_path)

    # Run the selective search algorithm
    regions = ss.run(image)

    # Visualize the proposed regions by drawing bounding boxes around them on the input image
    for region in regions:
        x, y, w, h = region
        cv2.rectangle(image, (x, y), (x + w, y + h), (0, 255, 0), 2)

    # Display the input image with the proposed regions highlighted
    cv2.imshow(""Object Detection"", image)
    cv2.waitKey(0)
    cv2.destroyAllWindows()

# Run the object detection visualization
object_detection_visualization(""input_image.jpg"")
```

