class FinancialInstrument:
    def __init__(self, instrument_type, unit_price):
        self.instrument_type = instrument_type
        self.unit_price = unit_price

    def calculate_value(self, quantity):
        return self.unit_price * quantity

CFD = FinancialInstrument(2, 100)
METAL = FinancialInstrument(3, 50)
CURRENCY = FinancialInstrument(1, 1)
def test_calculate_value():
    cfd = CFD(100)
    assert cfd.calculate_value(5) == 500

    metal = METAL(50)
    assert metal.calculate_value(10) == 500

    currency = CURRENCY(1)
    assert currency.calculate_value(100) == 100
