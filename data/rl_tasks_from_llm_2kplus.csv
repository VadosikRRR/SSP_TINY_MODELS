import re

def calculate_average(input_string: str) -> Dict[str, float]:
    data = {}
    lines = input_string.split('\n')
    for line in lines:
        match = re.match(r'(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{4})\t(\d+)', line)
        if match:
            timestamp, value = match.groups()
            if timestamp in data:
                data[timestamp].append(int(value))
            else:
                data[timestamp] = [int(value)]
    averages = {}
    for timestamp, values in data.items():
        averages[timestamp] = sum(values) / len(values)
    return averages

