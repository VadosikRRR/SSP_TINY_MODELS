class TestRule:
    def setup(self):
        self.app = Rule('open', 'team1', 'queue1', 1, False)

    def test_is_active(self):
        self.assertTrue(self.app.is_active())

    def test_is_inactive(self):
        self.app = Rule('closed', 'team1', 'queue1', 1, False)
        self.assertFalse(self.app.is_active())

    def test_is_active_with_active_only(self):
        self.app = Rule('open', 'team1', 'queue1', 1, True)
        self.assertTrue(self.app.is_active())

